# copy to .env (mode 600). To use a default, leave the line out. An empty global number (e.g. NEW_DAYS=), SMTP_TLS,
# SMTP_VERIFY_TLS, READ_ONLY, WEBHOOK_FORMAT, MAIL_ON_SOURCE, MAIL_ON_WATCH, UI_LANG or LOG_FORMAT means its default (UI_LANG and LOG_FORMAT: auto); other empty text settings are taken as empty; an empty connector yes/no or choice setting is refused.
#
# Sources: every source is a connector instance. LW_CONNECTORS lists the instance names (only a-z and 0-9) in merge
# order; each takes LW_CONNECTOR__<NAME>__<KEY> settings with the name upper-cased. TYPE is required (opnsense,
# snmp_switch, unifi, or a loaded third-party type: `python -m leasewatch check` lists them); TIMEOUT (seconds,
# default 60) caps one collect. Any secret key also accepts <KEY>_FILE, a file whose content is the value. At least
# one instance must produce sightings (opnsense). Drop an instance you do not use from LW_CONNECTORS together with
# its LW_CONNECTOR__<NAME>__* lines.
LW_CONNECTORS=fw1,switch,unifi
# Optional: a directory of third-party connector packages (one subdirectory per package with its pyproject.toml, as
# in contrib/). No default. Connectors run with leasewatch's full privileges: mount it read-only, e.g.
# ./connectors:/connectors:ro with LW_CONNECTORS_DIR=/connectors.
LW_CONNECTORS_DIR=

# The firewall: an OPNsense API user with only the DHCPv4 leases privilege (Kea, dnsmasq or ISC) + "Diagnostics: ARP Table".
LW_CONNECTOR__FW1__TYPE=opnsense
LW_CONNECTOR__FW1__URL=https://firewall.example.lan
LW_CONNECTOR__FW1__KEY=
LW_CONNECTOR__FW1__SECRET=
LW_CONNECTOR__FW1__VERIFY_TLS=1
# DHCPv4 server on the firewall: kea (Kea DHCPv4 leases), dnsmasq (Services: Dnsmasq DNS/DHCP: Settings, which also
# grants write: no read-only privilege exists; leases only, no reservation search) or isc (Services: ISC DHCPv4: Leases).
# ISC is end-of-life in OPNsense and moves to a plugin in 26.1; set isc for a firewall that still runs ISC.
LW_CONNECTOR__FW1__DHCP_BACKEND=kea
# interfaces to skip: identifier (opt3), device (igc4) or description (WAN), case-insensitive. "wan" covers the lease
# rows (identifier) and the ARP rows (if the WAN interface is described "WAN"); add the device name if the description differs.
LW_CONNECTOR__FW1__IGNORE_INTERFACES=wan,lo0
# 1 = also read the NDP table and the DHCPv6 leases and keep one IPv6 address per device (never presence, never a new
# device). Needs Diagnostics: NDP Table, and under Kea Services: DHCP: Kea(v6). 0 (default) = IPv4 only.
LW_CONNECTOR__FW1__IPV6=0
# 1 = requests to this firewall use http_proxy/https_proxy from the environment. 0 (default) = they go direct.
LW_CONNECTOR__FW1__PROXY=0

# Optional: switch port per device over SNMPv3 (read-only user; view mib-2 + LLDP).
LW_CONNECTOR__SWITCH__TYPE=snmp_switch
LW_CONNECTOR__SWITCH__HOST=switch.example.lan
LW_CONNECTOR__SWITCH__NAME=switch
# SNMP UDP port of the switch (default 161)
#LW_CONNECTOR__SWITCH__PORT=161
LW_CONNECTOR__SWITCH__USER=leasewatch
# SHA (default), SHA256, SHA224, SHA384, SHA512
LW_CONNECTOR__SWITCH__AUTH=SHA
LW_CONNECTOR__SWITCH__AUTH_KEY=
LW_CONNECTOR__SWITCH__PRIV_KEY=
# privacy protocol: AES (AES-128, default), AES192, AES256 (Cisco key extension), AES192B, AES256B (Blumenthal)
#LW_CONNECTOR__SWITCH__PRIV=AES
# SNMP switch profile. Empty = detected from sysObjectID/sysDescr.
# Built-in: standard, comware, cisco_ios, routeros, jetstream, zynos, edgeswitch (list: python -m leasewatch snmp-profiles)
#LW_CONNECTOR__SWITCH__PROFILE=
# Path to your own JSON profile (wins over PROFILE); it may "extends" a built-in one
#LW_CONNECTOR__SWITCH__PROFILE_FILE=
# MACs on one port without an LLDP neighbour that make it an uplink (empty = the profile's uplink.min_macs, 6)
#LW_CONNECTOR__SWITCH__MIN_MACS=

# Optional: Wi-Fi SSID/AP/signal from a UniFi controller (classic session API, a read-only admin).
LW_CONNECTOR__UNIFI__TYPE=unifi
LW_CONNECTOR__UNIFI__URL=https://unifi.example.lan
LW_CONNECTOR__UNIFI__SITE=default
LW_CONNECTOR__UNIFI__USER=
LW_CONNECTOR__UNIFI__PASSWORD=
# or, on a UniFi OS console, a revocable API key instead of a login (no SSID or signal then; see README):
# LW_CONNECTOR__UNIFI__AUTH=apikey
# LW_CONNECTOR__UNIFI__API_KEY=
LW_CONNECTOR__UNIFI__VERIFY_TLS=1
# controller type: auto (default) detects; classic = self-hosted Network app; unifi_os = UniFi OS console (untested on hardware)
# LW_CONNECTOR__UNIFI__PLATFORM=auto
LW_CONNECTOR__UNIFI__PROXY=0
#LW_CONNECTOR__UNIFI__TIMEOUT=60

POLL_SECONDS=120
NEW_DAYS=7
ONLINE_GRACE_MINUTES=10
# archive devices that have not been online for this many days and have no name and are not marked known (also those
# present at the start); they come back to the list when they are online again. 0 (default) = off
PRUNE_DAYS=0
# delete archived devices (0-3650 days archived, by the prune clock) that are offline, unnamed, without a note and not
# known, with all their rows; a purged MAC seen again is a new device. 0 (default) = off
PURGE_DAYS=0
# rotating phone addresses (private MACs) that never merged, with no name, note or ack, are archived after this many
# days offline (2-3650, never longer than PRUNE_DAYS) instead of PRUNE_DAYS. 0 (default) = use PRUNE_DAYS
PRUNE_PRIVATE_DAYS=0
# days to keep events (1-3650); a hand-restored device is protected from PRUNE_DAYS only while its `restored` event exists
EVENT_DAYS=365
# history rows kept and shown per device (10-1000)
HISTORY_PER_DEVICE=200
# days to keep how long each device was on each Wi-Fi network (0-3650; 0 = off: nothing is stored, stored rows are deleted)
WIFI_PRESENCE_DAYS=365
# dated backups that `python -m leasewatch backup` keeps in DATA_DIR/backups/ (0-1000; 0 = keep all)
BACKUP_KEEP=7
# lease type of a device whose lease is gone (ARP only): keep (last type), grace (cleared after ONLINE_GRACE_MINUTES
# without a lease), immediate (cleared at the first poll without a lease)
LEASE_TYPE_MODE=keep
SITE_NAME=Leasewatch
PUBLIC_URL=https://leases.example.lan
# Host header names allowed to use the page/API (guards against DNS rebinding). Default: the host in PUBLIC_URL.
# IP addresses and localhost always work. Several: comma separated. "*" accepts any name.
ALLOWED_HOSTS=
# Optional login (HTTP basic auth) for every path, /healthz included. Set both or neither; empty = no login.
# AUTH_PASSWORD_HASH: the line printed by `python -m leasewatch hash-password`. Use HTTPS (reverse proxy) with it.
AUTH_USER=
AUTH_PASSWORD_HASH=
# Optional: a second login that can look but not change anything; e.g. a status display or the family.
# Needs AUTH_USER; a different user name, the hash made the same way. Set both or neither.
# AUTH_RO_PASSWORD_HASH must use the same iteration count as AUTH_PASSWORD_HASH (same `hash-password --iterations`).
AUTH_RO_USER=
AUTH_RO_PASSWORD_HASH=
# READ_ONLY=1 refuses every change through the API (names, notes, acknowledge, archive). Default 0.
# WRITE_ALLOW: addresses or networks (IPv4 only, comma separated, e.g. 10.0.1.0/24, 10.0.2.5) that may change
# data, judged by the connection's own address, never X-Forwarded-For. Empty = everyone. Behind a reverse proxy
# every request comes from the proxy: restrict at the proxy or use READ_ONLY. READ_ONLY wins over WRITE_ALLOW.
READ_ONLY=0
WRITE_ALLOW=
# mail on new devices through the Mailgun HTTP API (always through http(s)_proxy if set); leave MAILGUN_KEY empty to disable
MAILGUN_KEY=
MAILGUN_DOMAIN=mg.example.com
MAIL_TO=you@example.com
MAIL_FROM_NAME=leasewatch
# Mailgun API endpoint; EU-region domains need https://api.eu.mailgun.net
MAILGUN_API_BASE=https://api.mailgun.net
# mail through an SMTP server (on when SMTP_HOST and SMTP_FROM are set; uses MAIL_TO and MAIL_FROM_NAME above).
# SMTP_TLS: starttls (default, port 587, required), tls (implicit TLS, port 465) or none (port 25, LAN relay).
# SMTP_PORT overrides the port. SMTP_USER and SMTP_PASSWORD: both or neither, ASCII; a password needs starttls or tls.
# SMTP_FROM: a plain ASCII address (name@domain, no <>).
# SMTP_VERIFY_TLS=0 accepts any certificate (self-signed relay). SMTP never uses http(s)_proxy.
SMTP_HOST=
SMTP_PORT=
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_VERIFY_TLS=1
# a POST per batch of new devices (on when WEBHOOK_URL is set). The URL is a secret: it often holds the token.
# WEBHOOK_FORMAT: json (default), ntfy (WEBHOOK_URL = the topic URL) or discord (the channel's webhook URL).
# WEBHOOK_SECRET (optional) signs requests per Standard Webhooks; a whsec_<base64> value is base64-decoded (not empty).
# Uses http(s)_proxy when set; add a LAN receiver to no_proxy.
WEBHOOK_URL=
WEBHOOK_FORMAT=json
WEBHOOK_SECRET=
# mail or webhook when a source stays down 3 polls, and again when it is back (the source_down/source_up
# events; 1/0, default 0). Needs one of the channels above.
MAIL_ON_SOURCE=0
# mail or webhook, one digest per poll, when a watched device (the Watch flag on its page) goes offline (after
# ONLINE_GRACE_MINUTES), comes back online, or changes IP, network, switch port or Wi-Fi (1/0, default 0).
MAIL_ON_WATCH=0
LOG_LEVEL=INFO
# auto (default): plain lines, without the timestamp under journald; json: one JSON object per line for log drivers
LOG_FORMAT=auto
# auto = the browser's language (Swedish or English), or en / sv to pin it
UI_LANG=auto
# where the SQLite file lives and what to listen on; the Dockerfile sets these, override only for local development
#DATA_DIR=/data
#LISTEN_HOST=0.0.0.0
#LISTEN_PORT=8080
