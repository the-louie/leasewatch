# copy to .env (mode 600). A global setting left empty (e.g. NEW_DAYS=) means its default; to use a connector
# setting's default, leave its line out (an empty yes/no or choice setting is refused).
#
# Sources: every source is a connector instance. LW_CONNECTORS lists the instance names (only a-z and 0-9) in merge
# order; each takes LW_CONNECTOR__<NAME>__<KEY> settings with the name upper-cased. TYPE is required (opnsense,
# snmp_switch, unifi, or a loaded third-party type: `python -m leasewatch check` lists them); TIMEOUT (seconds,
# default 60) caps one collect. Any secret key also accepts <KEY>_FILE, a file whose content is the value. At least
# one instance must produce sightings (opnsense). Drop an instance you do not use from LW_CONNECTORS together with
# its LW_CONNECTOR__<NAME>__* lines.
LW_CONNECTORS=fw1,switch,unifi
# Optional: a directory of third-party connector packages (one subdirectory per package with its pyproject.toml, as
# in contrib/). No default. Connectors run with leasewatch's full privileges: mount it read-only, e.g.
# ./connectors:/connectors:ro with LW_CONNECTORS_DIR=/connectors.
LW_CONNECTORS_DIR=

# The firewall: an OPNsense API user with only the DHCPv4 leases privilege (Kea, dnsmasq or ISC) + "Diagnostics: ARP Table".
LW_CONNECTOR__FW1__TYPE=opnsense
LW_CONNECTOR__FW1__URL=https://firewall.example.lan
LW_CONNECTOR__FW1__KEY=
LW_CONNECTOR__FW1__SECRET=
LW_CONNECTOR__FW1__VERIFY_TLS=1
# DHCPv4 server on the firewall: kea (Kea DHCPv4 leases), dnsmasq (Services: Dnsmasq DNS/DHCP: Settings, which also
# grants write: no read-only privilege exists; leases only, no reservation search) or isc (Services: ISC DHCPv4: Leases).
# ISC is end-of-life in OPNsense and moves to a plugin in 26.1; set isc for a firewall that still runs ISC.
LW_CONNECTOR__FW1__DHCP_BACKEND=kea
# interfaces to skip: identifier (opt3), device (igc4) or description (WAN), case-insensitive. "wan" covers the lease
# rows (identifier) and the ARP rows (if the WAN interface is described "WAN"); add the device name if the description differs.
LW_CONNECTOR__FW1__IGNORE_INTERFACES=wan,lo0
# 1 = requests to this firewall use http_proxy/https_proxy from the environment. 0 (default) = they go direct.
LW_CONNECTOR__FW1__PROXY=0

# Optional: switch port per device over SNMPv3 (read-only user; view mib-2 + LLDP). The instance named "switch" also
# fills the deprecated meta.switch API object.
LW_CONNECTOR__SWITCH__TYPE=snmp_switch
LW_CONNECTOR__SWITCH__HOST=switch.example.lan
LW_CONNECTOR__SWITCH__NAME=switch
LW_CONNECTOR__SWITCH__USER=leasewatch
LW_CONNECTOR__SWITCH__AUTH=SHA
LW_CONNECTOR__SWITCH__AUTH_KEY=
LW_CONNECTOR__SWITCH__PRIV_KEY=
# SNMP switch profile. Empty = detected from sysObjectID/sysDescr.
# Built-in: standard, comware, cisco_ios, routeros, jetstream, zynos, edgeswitch (list: python -m leasewatch snmp-profiles)
#LW_CONNECTOR__SWITCH__PROFILE=
# Path to your own JSON profile (wins over PROFILE); it may "extends" a built-in one
#LW_CONNECTOR__SWITCH__PROFILE_FILE=
# MACs on one port without an LLDP neighbour that make it an uplink (empty = the profile's uplink.min_macs, 6)
#LW_CONNECTOR__SWITCH__MIN_MACS=

# Optional: Wi-Fi SSID/AP/signal from a UniFi controller (classic session API, a read-only admin). The instance named
# "unifi" also fills the deprecated meta.unifi API object.
LW_CONNECTOR__UNIFI__TYPE=unifi
LW_CONNECTOR__UNIFI__URL=https://unifi.example.lan
LW_CONNECTOR__UNIFI__SITE=default
LW_CONNECTOR__UNIFI__USER=
LW_CONNECTOR__UNIFI__PASSWORD=
LW_CONNECTOR__UNIFI__VERIFY_TLS=1
LW_CONNECTOR__UNIFI__PROXY=0
#LW_CONNECTOR__UNIFI__TIMEOUT=60

POLL_SECONDS=120
NEW_DAYS=7
ONLINE_GRACE_MINUTES=10
# lease type of a device whose lease is gone (ARP only): keep (last type), grace (cleared after ONLINE_GRACE_MINUTES
# without a lease), immediate (cleared at the first poll without a lease)
LEASE_TYPE_MODE=keep
SITE_NAME=Leasewatch
PUBLIC_URL=https://leases.example.lan
# Host header names allowed to use the page/API (guards against DNS rebinding). Default: the host in PUBLIC_URL.
# IP addresses and localhost always work. Several: comma separated. "*" accepts any name.
ALLOWED_HOSTS=
# mail on new devices through the Mailgun HTTP API (always through http(s)_proxy if set); leave MAILGUN_KEY empty to disable
MAILGUN_KEY=
MAILGUN_DOMAIN=mg.example.com
MAIL_TO=you@example.com
MAIL_FROM_NAME=leasewatch
# Mailgun API endpoint; EU-region domains need https://api.eu.mailgun.net
MAILGUN_API_BASE=https://api.mailgun.net
LOG_LEVEL=INFO
# where the SQLite file lives and what to listen on; the Dockerfile sets these, override only for local development
#DATA_DIR=/data
#LISTEN_HOST=0.0.0.0
#LISTEN_PORT=8080
