# copy to .env (mode 600). OPNsense API user with only the DHCPv4 leases privilege (ISC or Kea) + "Diagnostics: ARP Table".
FW1_URL=https://firewall.example.lan
FW1_KEY=
FW1_SECRET=
FW1_VERIFY_TLS=1
# DHCPv4 server on the firewall: kea (Kea DHCPv4 leases) or isc (Services: ISC DHCPv4: Leases). ISC is end-of-life in
# OPNsense and moves to a plugin in 26.1; set isc for a firewall that still runs ISC.
DHCP_BACKEND=kea
POLL_SECONDS=120
NEW_DAYS=7
ONLINE_GRACE_MINUTES=10
# lease type of a device whose lease is gone (ARP only): keep (last type), grace (cleared after ONLINE_GRACE_MINUTES
# without a lease), immediate (cleared at the first poll without a lease)
LEASE_TYPE_MODE=keep
# 1 = firewall and UniFi requests use http_proxy/https_proxy from the environment. 0 (default) = they go direct; mail always uses the proxy settings.
PROXY_FOR_LAN=0
# interfaces to skip: identifier (opt3), device (igc4) or description (WAN), case-insensitive. "wan" covers the lease
# rows (identifier) and the ARP rows (if the WAN interface is described "WAN"); add the device name if the description differs.
IGNORE_INTERFACES=wan,lo0
SITE_NAME=Leasewatch
PUBLIC_URL=https://leases.example.lan
# Host header names allowed to use the page/API (guards against DNS rebinding). Default: the host in PUBLIC_URL.
# IP addresses and localhost always work. Several: comma separated. "*" accepts any name.
ALLOWED_HOSTS=
# mail on new devices through the Mailgun HTTP API; leave MAILGUN_KEY empty to disable
MAILGUN_KEY=
MAILGUN_DOMAIN=mg.example.com
MAIL_TO=you@example.com
MAIL_FROM_NAME=leasewatch
# Mailgun API endpoint; EU-region domains need https://api.eu.mailgun.net
MAILGUN_API_BASE=https://api.mailgun.net
# optional: switch port per device over SNMPv3 (read-only user; view mib-2 + LLDP). Empty SNMP_HOST = off.
SNMP_HOST=
SNMP_NAME=switch
SNMP_USER=leasewatch
SNMP_AUTH=SHA
SNMP_AUTH_KEY=
SNMP_PRIV_KEY=
# optional: Wi-Fi SSID/AP/signal from the UniFi controller (classic session API, a read-only admin). Empty UNIFI_URL = off.
UNIFI_URL=
UNIFI_SITE=default
UNIFI_USER=
UNIFI_PASSWORD=
UNIFI_VERIFY_TLS=1
LOG_LEVEL=INFO
# where the SQLite file lives and what to listen on; the Dockerfile sets these, override only for local development
#DATA_DIR=/data
#LISTEN_HOST=0.0.0.0
#LISTEN_PORT=8080
